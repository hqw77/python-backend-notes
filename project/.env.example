# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=learn_mysql

# 连接池参数
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# 认证参数
# ⚠️ 生产环境必须换成随机长字符串，长度不少于 32 字节
JWT_SECRET=dev-secret-change-me-please-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=300